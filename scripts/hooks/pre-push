#!/bin/sh
#
# pre-push: run the per-PR CI checks that are cheap enough to pay at push time
#
# ここが持つのは **「push する range を見て、どの検査を鳴らすか」だけ**。検査の実体と
# 復旧手順のメッセージは scripts/check-generated-freshness.sh（生成物の鮮度）と
# Makefile の static-check-fast / docs-check が正本で、pre-push を通らない経路
# （scripts/signed-commit.py の GraphQL コミット）も同じものを呼ぶ（Issue #978 / #1155）。
#
# **なぜ CI の検査をここでも鳴らすのか**（Issue #1155）。ここが鳴らすのは
# `build-and-test` が **required かつ無条件**に走らせるステップだけで、新しい規則は
# 1 つも導入していない — 失敗を手元へ早めているだけ。これは #333（swift-format）と
# #788（リファレンス画像）で 2 度下した判断と同じ基準で、「push 前に make ci-check」
# という**文書ルールは実測で守られなかった**（#1020 の取りこぼし 14 ステップ、#978 の
# 検査ゼロで入った 22 コミット）。
#
# 払うコストの上限も既に決まっている: ここは `Sources/**/*.swift` を触った push で
# `make llms-txt`（= `swift build` + symbol graph 抽出）を丸ごと走らせる。今回足した
# 2 本はその下に収まる（実測 static-check-fast 5 秒強 / docs-check 3 秒強）。
# `scripts/tests`（実測 35 秒）だけは載せていない — 理由は Makefile の static-check 側。
#
# 降りたいときは `git push --no-verify`。CI が同じ検査を独立に走らせるので、
# 降りても歯止めが消えるわけではない（早く気付けなくなるだけ）。
#
# トリガーを分けているのは、経路ごとに「何を見られるか」が違うため。ここは range
# （`base..local_sha`）を見られるので、マージで陳腐化した生成物も拾える。作業ツリー
# しか見られない signed-commit.py 側は代わりに全部を走らせる。理由の全文は
# check-generated-freshness.sh の冒頭。
#
# llms.txt is regenerated and verified when the push touches its inputs.
# そのリストは scripts/changed-llms-inputs.sh が正本で、per-PR CI も同じものを
# 呼ぶ（以前ここと ci.yml が別々にリストを持っていて、Makefile の symbol-graphs
# レシピを壊す変更が両方を素通りした — Issue #995）:
#   - Sources/**/*.swift
#   - scripts/generate-llms-txt.py
#   - Makefile（`llms-txt: symbol-graphs` のレシピ）
#
# docs/ai/examples-index.{md,json} is regenerated and verified when the
# push touches:
#   - Examples/**
#   - scripts/generate-examples-index.py
#
# docs/tutorial/*.md の埋め込みコードと実行結果画像は、次に触れたときに検証される:
#   - Examples/Tutorial/**
#   - docs/tutorial/**
#   - scripts/generate-tutorial-snippets.py
#   - scripts/generate-tutorial-shots.py
#   - scripts/shots_common.py
#
# doc コメントの実行結果画像（リファレンス）は、次に触れたときに検証される:
#   - Sources/**/*.swift（<!-- reference-shot --> 付きスニペットが正典）
#   - docs/reference/**（台帳 manifest.json と shots.config.json）
#   - scripts/generate-reference-shots.py
#   - scripts/shots_common.py
#
# README 群が案内する「どこまで公開されているか」は、次に触れたときに検証される:
#   - docs/tutorial/**（frontmatter が正典）
#   - README.md / README.en.md / docs/README.md / docs/README.en.md / Examples/README.md
#   - scripts/generate-tutorial-status.py
#
# DocC の警告 0（`make docs-check`）は、次に触れたときに検証される。判定は
# scripts/changed-llms-inputs.sh --docc が正本で、ci.yml も同じ入口を呼ぶ:
#   - llms.txt の入力（上の 3 つ）
#   - Sources/**/*.docc/**（カタログ）
#
# ビルド不要な検査（`make static-check-fast`）だけはトリガーを持たず、削除だけの
# push を除いて毎回走る。CI が無条件に走らせている集合と一致させるため。
#
# If a regenerated file differs from the checked-in version, the hook aborts
# the push so the contributor can `git add` and amend.
#
# Activated by `make setup` (or `make hooks`) via
# `git config core.hooksPath ./scripts/hooks`.

set -e

# Read pushed refs from stdin per githooks(5) and detect changes for both
# generated artifacts. Format: <local_ref> <local_sha> <remote_ref> <remote_sha>
# When pushing a brand-new branch, remote_sha is 40 zeros — fall back to the
# merge-base with origin/main.
needs_static=0
needs_llms=0
needs_index=0
needs_shaders=0
needs_tutorial=0
needs_reference=0
needs_status=0
needs_format=0
needs_docc=0
zero=0000000000000000000000000000000000000000

while read -r _ local_sha _ remote_sha; do
    # Skip deletes (local_sha == zero)
    [ "$local_sha" = "$zero" ] && continue

    # ビルド不要な検査（static-check-fast）だけは range を見ない。CI が無条件に
    # 走らせているものと**同じ集合**に保つためで、パスで絞ると 2 つの向きに壊れる:
    # 絞りすぎれば取りこぼし、広げすぎれば「自分が入れていない指摘」で止まる。
    # 11 本ぶんのトリガーリストを保守する費用も、5 秒を払う費用を上回る（#1155）。
    needs_static=1

    if [ "$remote_sha" = "$zero" ]; then
        # New branch: compare against origin/main if available
        base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
        if [ -z "$base" ]; then
            # No baseline — assume all checks are needed
            needs_llms=1
            needs_index=1
            needs_shaders=1
            needs_tutorial=1
            needs_reference=1
            needs_status=1
            # 「全部」と書いてあるのに needs_format だけ抜けていた（#1155 で気付いた
            # 取りこぼし）。落ちるのは baseline を辿れない push だけなので目立たない。
            needs_format=1
            needs_docc=1
            break
        fi
    else
        base="$remote_sha"
    fi
    range="${base}..${local_sha}"

    # llms.txt の入力は scripts/changed-llms-inputs.sh が正本（Issue #995）。
    # そちらは 3 点表記で取るが、push 時の remote_sha は local_sha の祖先なので
    # "$range" と同じ結果になる（相手が先に進んでいるときは 3 点のほうが正しい）。
    if scripts/changed-llms-inputs.sh "$base" "$local_sha" | grep -q .; then
        needs_llms=1
    fi
    # examples index depends on Examples/ AND on its generator script.
    if git diff --name-only "$range" \
        -- 'Examples/' 'scripts/generate-examples-index.py' \
        | grep -q .; then
        needs_index=1
    fi
    # shader sources (.txt) depend on Metal/*.metal AND on the generator script.
    if git diff --name-only "$range" \
        -- 'Sources/MetaphorCore/Shaders/' 'scripts/generate-shader-sources.py' \
        | grep -q .; then
        needs_shaders=1
    fi
    # tutorial snippets depend on the tutorial packages, the prose that embeds
    # them, AND the generator script. The result images hanging off the same
    # flag depend on two more: their own generator, and shots_common.py — which
    # is where the freshness fingerprint itself lives, so changing it restales
    # every section at once (#788; it slipped through in #787).
    #
    # shots_common.py does not feed the *snippet* half, so it over-fires that
    # one check by ~0.05s. Splitting the flag to save that is not worth a
    # fourth trigger list.
    if git diff --name-only "$range" \
        -- 'Examples/Tutorial/' 'docs/tutorial/' \
           'scripts/generate-tutorial-snippets.py' \
           'scripts/generate-tutorial-shots.py' 'scripts/shots_common.py' \
        | grep -q .; then
        needs_tutorial=1
    fi
    # reference result images: the canonical source is the `<!-- reference-shot
    # -->` snippet in the doc comment, and the ledger/config live under
    # docs/reference/. Already a required CI gate (ci.yml), so this only moves
    # the failure earlier — it introduces no new rule (#788).
    if git diff --name-only "$range" \
        -- 'Sources/**/*.swift' 'docs/reference/' \
           'scripts/generate-reference-shots.py' 'scripts/shots_common.py' \
        | grep -q .; then
        needs_reference=1
    fi
    # publication status depends on the tutorial frontmatter, the entry docs
    # that advertise it, AND the generator script.
    if git diff --name-only "$range" \
        -- 'docs/tutorial/' 'README.md' 'README.en.md' 'docs/README.md' \
           'docs/README.en.md' 'Examples/README.md' \
           'scripts/generate-tutorial-status.py' \
        | grep -q .; then
        needs_status=1
    fi
    # swift-format は Swift のソース、設定、検査スクリプトのどれが動いても
    # 結果が変わりうる。CI の required ステップと同じものをここでも先に鳴らす
    # （新しい規則は導入していない — 失敗を早めるだけ。#333）。
    if git diff --name-only "$range" \
        -- 'Sources/**/*.swift' 'Tests/' 'Package.swift' \
           '.swift-format' 'scripts/lint-swift.sh' \
        | grep -q .; then
        needs_format=1
    fi
    # DocC の警告検査。入力は llms.txt のそれ + カタログ（*.docc/**）で、判定は
    # scripts/changed-llms-inputs.sh --docc が正本（ci.yml も同じ入口を呼ぶ — 以前
    # カタログの分だけ ci.yml が自前で足していて、pre-push が同じものを別に持つと
    # #995 のドリフトを再生産するため #1155 で寄せた）。
    if scripts/changed-llms-inputs.sh --docc "$base" "$local_sha" | grep -q .; then
        needs_docc=1
    fi
done

# --- ビルド不要な検査 ---------------------------------------------------------
#
# 先頭に置くのは ci.yml と同じ理由。あちらも「ビルド不要なので手前に置く」で
# lint 群を Build の前に並べてある。5 秒で分かる失敗を、下の `make llms-txt`
# （= swift build）を待ってから見るのは無駄。
if [ "$needs_static" -eq 1 ]; then
    if ! make static-check-fast; then
        echo "" >&2
        echo "[pre-push] ❌ CI と同じ検査が落ちた（理由は上の出力）。直してから push してください:" >&2
        echo "" >&2
        echo "    make static-check-fast   # ここだけをもう一度" >&2
        echo "    make ci-check            # CI と同条件で全部" >&2
        echo "" >&2
        echo "[pre-push] どうしても今 push するなら git push --no-verify（CI が同じ検査を独立に走らせます）。" >&2
        exit 1
    fi
fi

# --- 生成物の鮮度 -------------------------------------------------------------
#
# 鳴らす検査を集めて、実体へ一度で渡す（順序は実体側の並びが決める）。
checks=""
[ "$needs_llms" -eq 1 ] && checks="$checks llms"
[ "$needs_index" -eq 1 ] && checks="$checks index"
[ "$needs_shaders" -eq 1 ] && checks="$checks shaders"
[ "$needs_tutorial" -eq 1 ] && checks="$checks tutorial"
[ "$needs_reference" -eq 1 ] && checks="$checks reference"
[ "$needs_status" -eq 1 ] && checks="$checks status"
[ "$needs_format" -eq 1 ] && checks="$checks format"

if [ -n "$checks" ]; then
    # shellcheck disable=SC2086  # 検査名の並びは意図的に単語分割させる
    scripts/check-generated-freshness.sh --label '[pre-push]' $checks
fi

# --- DocC の警告 0 ------------------------------------------------------------
#
# 最後に置くのはビルドを要求するため。上の llms 検査が鳴った push では `make llms-txt`
# が既にビルドを済ませているので、ここで増えるのは symbol graph の再抽出 + docc convert
# だけ（実測 3.2 秒）。カタログだけを直した push では llms 検査が鳴らないので、ここが
# 素の `swift build` を一度通る — CI の `Verify DocC builds without warnings` と同じ形。
if [ "$needs_docc" -eq 1 ]; then
    if ! make docs-check; then
        echo "" >&2
        echo "[pre-push] ❌ DocC の警告が 0 件ではない（CI の必須ステップと同じ検査）。" >&2
        echo "[pre-push] ほとんどは解決できないシンボルリンク。シグネチャは llms.txt が正本です:" >&2
        echo "" >&2
        echo "    grep -nE 'func <名前>\\(' llms.txt" >&2
        echo "    make docs-check          # 直したらもう一度" >&2
        echo "" >&2
        echo "[pre-push] どうしても今 push するなら git push --no-verify。" >&2
        exit 1
    fi
fi

exit 0
