# Xcode
#
# gitignore contributors: remember to update Global/Xcode.gitignore, Objective-C.gitignore & Swift.gitignore

## User settings
xcuserdata/

## Obj-C/Swift specific
*.hmap

## App packaging
*.ipa
*.dSYM.zip
*.dSYM

## Playgrounds
timeline.xctimeline
playground.xcworkspace

# Swift Package Manager
#
# Add this line if you want to avoid checking in source code from Swift Package Manager dependencies.
# Packages/
# Package.pins
# Package.resolved
# *.xcodeproj
#
# Examples は path 依存だけなので普段は Package.resolved が生まれないが、
# url 依存（metaphor-syphon）を持つ Tutorial/08-Connect/03-Syphon はビルドのたびに作る。
# pin を固定する理由が無い（from: の最新を使う）ので commit しない。
Examples/**/Package.resolved
#
# Xcode automatically generates this directory with a .xcworkspacedata file and xcuserdata
# hence it is not needed unless you have added a package configuration file to your project
.swiftpm/

.build/

# Coverage reports (CI artifact; reproducible locally — see .github/workflows/ci.yml)
coverage/

# CocoaPods
#
# We recommend against adding the Pods directory to your .gitignore. However
# you should judge for yourself, the pros and cons are mentioned at:
# https://guides.cocoapods.org/using/using-cocoapods.html#should-i-check-the-pods-directory-into-source-control
#
# Pods/
#
# Add this line if you want to avoid checking in source code from the Xcode workspace
# *.xcworkspace

# Carthage
#
# Add this line if you want to avoid checking in source code from Carthage dependencies.
# Carthage/Checkouts

Carthage/Build/

# fastlane
#
# It is recommended to not store the screenshots in the git repo.
# Instead, use fastlane to re-generate the screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://docs.fastlane.tools/best-practices/source-control/#source-control

fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Created by https://www.toptal.com/developers/gitignore/api/macos
# Edit at https://www.toptal.com/developers/gitignore?templates=macos

### macOS ###
# General
.DS_Store
.AppleDouble
.LSOverride

# Icon must end with two \r
Icon


# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

### macOS Patch ###
# iCloud generated files
*.icloud

# End of https://www.toptal.com/developers/gitignore/api/macos

# Sandbox (local experiments, not tracked)
sandbox/

# Generated reports
examples-report.md

# Claude Code local state
.claude/scheduled_tasks.lock
.claude/settings.local.json

# MetaphorProbe runtime artifacts (snapshot output + request file)
.metaphor/

# Files written by running the examples (save() / beginFrameRecord() / video / SVG)
Examples/**/output/

# チュートリアルの画像は Gyazo に置き、リポジトリは本文と台帳(manifest.json /
# motion.json)だけを持つ(ADR-0010)。撮影の一時出力は .build/tutorial-shots/ だが、
# 手で置いた・古い版から復活した画像がうっかり混ざらないようここでも塞ぐ
docs/tutorial/images/**/*.png
docs/tutorial/images/**/*.webp
docs/tutorial/images/**/*.gif

# Python bytecode cache (scripts/ generators and their tests)
__pycache__/
*.pyc

# Secrets — 秘密情報の置き場はここに限る（コード・fixtures・ログ・コミットに入れない）
.env
.env.*
!.env.example
