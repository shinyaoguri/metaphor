---
import { render } from 'astro:content';
import TutorialLayout from '../../layouts/TutorialLayout.astro';
import TutorialArticle from '../../components/TutorialArticle.astro';
import { getContent } from '../../i18n/ui';
import { tutorialStaticPaths, type TutorialPart } from '../../lib/tutorial';
import type { Lang } from '../../i18n/ui';

// 本文（docs/tutorial/NN-slug.md）が 1 本も無ければ空配列 = ページ 0 枚。
// 一覧（index.astro）は静的ルートなので、その場合も /tutorial/ は出る。
export async function getStaticPaths() {
  return tutorialStaticPaths('ja');
}

interface Props {
  lang: Lang;
  part: TutorialPart;
  parts: TutorialPart[];
  prev?: TutorialPart;
  next?: TutorialPart;
}

const { lang, part, parts, prev, next } = Astro.props as Props;
const t = getContent(lang);
const { headings } = await render(part.entry);
---

<TutorialLayout
  lang={lang}
  title={`${part.title} — ${t.tutorial.title} — metaphor`}
  description={part.description ?? t.tutorial.meta.description}
  parts={parts}
  activeSlug={part.slug}
  headings={headings}
>
  <TutorialArticle lang={lang} part={part} prev={prev} next={next} />
</TutorialLayout>
