---
/**
 * GitHub Pages はサイト全体で 1 枚の 404.html しか見ないので、このページは
 * LP・チュートリアル・DocC リファレンスのどこで外しても出る。よって言語は
 * 決められない（日英を併記する）。
 *
 * もう 1 つの役割は **旧 URL の救済**。API リファレンスは以前 `/documentation/`
 * 直下に置かれていたが、Astro の出力と混ぜたことによる取りこぼしを断つため
 * `/reference/` 配下へ移した（#529）。GitHub Pages にリダイレクト機能は無いので、
 * ここでクライアント側から新しい URL へ送る。
 */
import Layout from '../layouts/Layout.astro';
import { base } from '../i18n/ui';

const links = [
  { href: `${base}/`, ja: 'トップ', en: 'Home' },
  { href: `${base}/tutorial/`, ja: 'チュートリアル', en: 'Tutorial' },
  {
    href: `${base}/reference/documentation/metaphor/`,
    ja: 'API リファレンス',
    en: 'API reference',
  },
];
---

<Layout title="404 — metaphor" description="Page not found.">
  <script is:inline define:vars={{ base }}>
    // 旧 /documentation/** を /reference/documentation/** へ送る。ページを描く前に
    // 判定したいので inline（Astro のバンドルを待つと 404 が一瞬見える）。
    const legacyPrefix = `${base}/documentation/`;
    const { pathname, search, hash } = window.location;
    if (pathname.startsWith(legacyPrefix)) {
      const rest = pathname.slice(legacyPrefix.length);
      window.location.replace(`${base}/reference/documentation/${rest}${search}${hash}`);
    }
  </script>

  <main class="flex min-h-screen items-center justify-center px-6">
    <div class="mx-auto max-w-xl text-center">
      <p class="font-mono text-sm tracking-widest text-accent">404</p>
      <h1 class="font-display mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">
        ページが見つかりません
      </h1>
      <p class="mt-3 text-lg text-text-muted">Page not found.</p>
      <p class="mt-6 leading-relaxed text-text-muted">
        URL が変わったか、まだ存在しないページです。<br />
        <span class="text-sm">The page may have moved, or it does not exist yet.</span>
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="inline-flex items-center gap-2 rounded-full border border-border bg-surface/80 px-5 py-2.5 text-sm font-semibold text-text backdrop-blur transition-all hover:border-accent/50 hover:bg-surface"
            >
              {link.ja}
              <span class="text-text-muted">/ {link.en}</span>
            </a>
          ))
        }
      </div>
    </div>
  </main>
</Layout>
