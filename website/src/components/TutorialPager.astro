---
import { getContent, type Lang } from '../i18n/ui';
import type { TutorialPart } from '../lib/tutorial';

interface Props {
  lang: Lang;
  prev?: TutorialPart;
  next?: TutorialPart;
}

const { lang, prev, next } = Astro.props;
const t = getContent(lang);
---

{
  (prev || next) && (
    <nav class="mt-16 grid gap-4 border-t border-border pt-8 sm:grid-cols-2">
      {prev ? (
        <a
          href={prev.href}
          rel="prev"
          class="group rounded-2xl border border-border bg-surface px-5 py-4 transition-colors hover:border-accent/50"
        >
          <span class="text-xs font-semibold tracking-widest text-text-muted uppercase">
            ← {t.tutorial.prev}
          </span>
          <span class="mt-1 block font-medium text-text transition-colors group-hover:text-accent">
            {prev.title}
          </span>
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a
          href={next.href}
          rel="next"
          class="group rounded-2xl border border-border bg-surface px-5 py-4 text-right transition-colors hover:border-accent/50 sm:col-start-2"
        >
          <span class="text-xs font-semibold tracking-widest text-text-muted uppercase">
            {t.tutorial.next} →
          </span>
          <span class="mt-1 block font-medium text-text transition-colors group-hover:text-accent">
            {next.title}
          </span>
        </a>
      )}
    </nav>
  )
}
